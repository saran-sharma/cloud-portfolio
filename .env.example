# EmailJS: public identifiers only. Copy this file to .env and replace the placeholders.
# These values are visible in the shipped JavaScript. Never add an EmailJS private key here.
# On Vercel: Settings > Environment Variables, same names, then redeploy.
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
